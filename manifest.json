{
  "manifest_version": 3,
  "name": "GestureBackHistory",
  "version": "0.4.1",
  "description": "Access familiar browser navigation features quickly and easily with intuitive gestures.",
  "minimum_chrome_version": "102",
  "permissions": [
    "debugger",
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "GestureBackHistory settings",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content/page-styles.css"
      ],
      "js": [
        "content/menu-styles.js",
        "content/history-client.js",
        "content/history-menu.js",
        "content/gesture-analyzer.js",
        "content/gesture-controller.js",
        "content/index.js"
      ],
      "run_at": "document_start"
    }
  ]
}
